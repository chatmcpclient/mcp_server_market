{
    "mcpServers": {
        "sqlite": {
            "command": "uvx",
            "args": [
                "mcp-server-sqlite",
                "--db-path",
                "/path/to/test.db"
            ]
        },
        "fetch": {
            "command": "uvx",
            "args": [
                "mcp-server-fetch"
            ]
        },
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/path/to/allowed/files"
            ]
        },
        "git": {
            "command": "uvx",
            "args": [
                "mcp-server-git",
                "--repository",
                "path/to/git/repo"
            ]
        },
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_TOKEN>"
            }
        },
        "postgres": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-postgres",
                "postgresql://localhost/mydb"
            ]
        },
        "Turkiye-Legal-MCP": {
            "command": "uvx",
            "args": [
                "--from",
                "git+https://github.com/saidsurucu/yargi-mcp",
                "yargi-mcp"
            ],
            "env": {"key": "yargimcp"}
        },
        "yolfi-payments": {
            "command": "npx",
            "args": [
                "-y",
                "@yolfi/agent",
                "mcp"
            ]
        },
        "xquik": {
            "command": "npx",
            "args": [
                "-y",
                "mcp-remote@0.1.38",
                "https://xquik.com/mcp",
                "--transport",
                "http-only"
            ]
        }
    }
}
