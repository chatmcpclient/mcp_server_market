{
    "mcpServers": {
        "sqlite": {
            "command": "uvx",
            "args": [
                "mcp-server-sqlite",
                "--db-path",
                "/path/to/test.db"
            ]
        },
        "fetch": {
            "command": "uvx",
            "args": [
                "mcp-server-fetch"
            ]
        },
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/path/to/allowed/files"
            ]
        },
        "git": {
            "command": "uvx",
            "args": [
                "mcp-server-git",
                "--repository",
                "path/to/git/repo"
            ]
        },
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_TOKEN>"
            }
        },
        "postgres": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-postgres",
                "postgresql://localhost/mydb"
            ]
        },
        "Turkiye-Legal-MCP": {
            "command": "uvx",
            "args": [
                "--from",
                "git+https://github.com/saidsurucu/yargi-mcp",
                "yargi-mcp"
            ],
            "env": {"key": "yargimcp"}
        },
        "dreamtune": {
            "command": "npx",
            "args": [
                "-y",
                "--package",
                "@dreamtune/sdk@0.1.2",
                "dreamtune-mcp"
            ],
            "env": {
                "DREAMTUNE_API_KEY": "<YOUR_DREAMTUNE_API_KEY>",
                "DREAMTUNE_API_ORIGIN": "https://api.dreamtunelabs.com",
                "DREAMTUNE_REQUEST_TIMEOUT_MS": "60000"
            }
        },
        "yolfi-payments": {
            "command": "npx",
            "args": [
                "-y",
                "@yolfi/agent",
                "mcp"
            ]
        }
    }
}
